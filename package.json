{
  "name": "larats",
  "version": "1.1.1",
  "description": "Smart Architecture Visualizer & Contextual Module Scaffolder CLI for Laravel and TypeScript projects",
  "keywords": [
    "larats",
    "architecture",
    "scanner",
    "visualizer",
    "scaffolder",
    "laravel",
    "typescript",
    "mermaid",
    "cli"
  ],
  "author": "Sidiq Fatuh <kmzbengbeng14@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SidiqFatuh187/Larats.git"
  },
  "homepage": "https://github.com/SidiqFatuh187/Larats#readme",
  "bugs": {
    "url": "https://github.com/SidiqFatuh187/Larats/issues"
  },
  "type": "module",
  "bin": {
    "larats": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit -p tsconfig.check.json",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "start": "node dist/index.js",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15"
  },
  "engines": {
    "node": ">=18.3.0"
  }
}
